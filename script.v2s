fn math() {
    print_number(2 * 2 == 4);
    print_number(2 + 2 * 2 == 6);
    print_number((2 + 2) * 2 == 8);
    print_number(!1 == 0);
    print_number(-40 == -40);
}

fn flow() {
    if 2 + 2 == 4 {
        print_string("2 + 2 IS 4");
    } else {
        print_string("2 + 2 is not 4??");
    }

    if 2 + 2 == 5 {
        print_string("2 + 2 is 5..?");
    } else if 2 + 1 == 3 {
        print_string("2 + 1 is 3!");
    }
}

fn flowering_night() {
    print_string("Tinged in bloody sin, one yet budding in the deep dim flooding field of ghostly flowers");
    wait(3.5);
    print_string("Folded neatly till bloomed completely, when the scent drifts sweetly but it quickly sours");
    wait(3);
    print_string("Breaking chains, so as to feel no pain to see the cold steel raining down in deadly showers");
    wait(3);
    print_string("With one swipe of hand, the clock is wiped again as clean as ere the day began -- go!");
    wait(3);
    print_string("Reckless chases through hazy places render distant faces ever distant-seeming");
    wait(3);
    print_string("Fate's reminder of the ties that bind her leaves the keen eye blinder to its true redeeming");
    wait(3.5);
    print_string("Swift transcension of all dimension, ever in suspension, as if only dreaming");
    wait(3);
    print_string("Airs ethereal with immaterial but potent power to deceive -- no!");
    wait(3);
    print_string("Tinged in bloody sin, one yet budding in the deep dim flooding field of ghostly flowers");
    wait(3);
    print_string("Folded neatly till bloomed completely, when the scent drifts sweetly but it quickly sours");
    wait(3);
    print_string("Come what may, for any price to pay, there will be still no way of turning back the hours");
    wait(3);
    print_string("Lifted to the present altitude upon the pleasant draft of past defeats -- stop!");
    wait(3);
    print_string("From the fondest sense of duty surges up the will to fight");
    wait(3);
    print_string("On those wings of heavy silver, let the maid take flight");
    wait(3);
    print_string("Shrouded in the brightest cover, bathed in this metallic light");
    wait(3);
    print_string("One may set upon this path, embracing the flowering night");
}

fn main() {
    print_string("hello, wonderful world!");
    math();
    flow();
    flowering_night();
}